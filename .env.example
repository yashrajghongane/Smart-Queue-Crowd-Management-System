# Environment Configuration Example
# Do not put actual secrets in this file!

# App config
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
PROJECT_NAME="Smart Queue System"

# Database
# For local dev: sqlite:///./queue.db
# For production: postgresql://user:password@server/db
DATABASE_URL=sqlite:///./queue.db

# Security
# Run `openssl rand -hex 32` to generate a secure secret key for sessions
SECRET_KEY=CHANGEME_SECRET_KEY_FOR_TESTING
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP / Verification
# Options: MOCK, OTP_PROVIDER (to be configured later)
VERIFICATION_PROVIDER=MOCK
